{
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "name": "homepage-workspace",
  "scripts": {
    "dev": "pnpm --filter simple-homepage dev",
    "lint": "pnpm -r --if-present lint && prettier . --check",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm --filter simple-homepage test:watch",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter simple-homepage preview",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "prettier": "3.8.3"
  }
}
